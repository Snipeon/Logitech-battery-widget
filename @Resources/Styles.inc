; Shared text formatting so device labels use the same appearance on every card.
[DeviceName]
FontFace=Segoe UI Semibold
FontSize=8
FontColor=177,184,196
AntiAlias=1
StringAlign=Center

; The large value shown inside the battery ring.
[DevicePercent]
FontFace=Segoe UI Semibold
FontSize=12
FontColor=245,247,250
AntiAlias=1
StringAlign=CenterCenter

; The small line under the device name for charging or retry status.
[DeviceCharge]
FontFace=Segoe UI Semibold
FontSize=8
FontColor=104,184,255
AntiAlias=1
StringAlign=Center
