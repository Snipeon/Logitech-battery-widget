; Shared timings for the Rainmeter skin and Rust helper.
; Refresh the Rainmeter skin after changing RainmeterUpdateMilliseconds.
; Rust reloads its settings while running; use whole seconds (1 to 86400).
; DiagnosticLogging=1 writes helper/discovery diagnostics; 0 disables new log entries.
RainmeterUpdateMilliseconds=1000
PollIntervalSeconds=3
DiscoveryIntervalSeconds=60
SnapshotCacheSeconds=15
DiagnosticLogging=0
